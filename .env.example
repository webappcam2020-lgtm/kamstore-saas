# ============================================
# KamStore SaaS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Application ----
APP_NAME=KamStore
DEBUG=true
ENVIRONMENT=development

# ---- Security ----
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL) ----
POSTGRES_USER=kamstore
POSTGRES_PASSWORD=kamstore_secret_2024
POSTGRES_DB=kamstore_db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://kamstore:kamstore_secret_2024@db:5432/kamstore_db

# ---- Redis ----
REDIS_PASSWORD=kamstore_redis_2024
REDIS_PORT=6379
REDIS_URL=redis://:kamstore_redis_2024@redis:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Backend ----
BACKEND_PORT=8000

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=KamStore

# ---- AI / Gemini API ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Payment Providers ----
# MTN Mobile Money (Cameroon)
MTN_MOMO_API_KEY=your-mtn-momo-api-key
MTN_MOMO_API_SECRET=your-mtn-momo-api-secret
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=XAF

# Orange Money
ORANGE_MONEY_API_KEY=your-orange-money-api-key
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_MERCHANT_KEY=your-merchant-key

# ---- External APIs ----
# Phone number lookup
NUMVERIFY_API_KEY=your-numverify-api-key

# Maps
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- File Storage ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Email (for notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@kamstore.cm
