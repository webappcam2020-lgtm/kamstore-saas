# ============================================
# KamStore SaaS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Application ----
APP_NAME=KamStore SaaS
DEBUG=true
ENVIRONMENT=development

# ---- Security ----
SECRET_KEY=your-super-secret-key-change-this-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL with pgvector) ----
POSTGRES_USER=kamstore
POSTGRES_PASSWORD=kamstore_secret_2024
POSTGRES_DB=kamstore_db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://kamstore:kamstore_secret_2024@db:5432/kamstore_db

# ---- Redis (Cache & Celery Broker) ----
REDIS_PASSWORD=kamstore_redis_2024
REDIS_PORT=6379
REDIS_URL=redis://:kamstore_redis_2024@redis:6379/0

# ---- Celery (Async Scraping, Emailing, Tasks) ----
CELERY_BROKER_URL=redis://:kamstore_redis_2024@redis:6379/0
CELERY_RESULT_BACKEND=redis://:kamstore_redis_2024@redis:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=KamStore

# ---- AI / NLP Engines (Lead Extraction & Chatbot) ----
# OpenAI API (GPT-4o-mini structured NER & lead extraction)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# HuggingFace API (Token classification & entity extraction)
HUGGINGFACE_API_TOKEN=your-huggingface-token-here

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Payment Gateways (MTN MoMo & Orange Money Cameroun) ----
# 1. Notch Pay API (https://api.notchpay.co)
NOTCHPAY_PUBLIC_KEY=sb.pub.your_notch_pay_public_key
NOTCHPAY_PRIVATE_KEY=sb.priv.your_notch_pay_private_key
NOTCHPAY_HASH_KEY=your_notch_pay_hash_key_for_webhooks
NOTCHPAY_WEBHOOK_SECRET=your_webhook_secret
NOTCHPAY_BASE_URL=https://api.notchpay.co

# 2. Campay API (https://campay.net)
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password
CAMPAY_WEBHOOK_SECRET=your_campay_webhook_secret
CAMPAY_ENVIRONMENT=sandbox
CAMPAY_BASE_URL=https://demo.campay.net/api

# Legacy Direct MoMo (Optional)
MTN_MOMO_API_KEY=your-mtn-momo-api-key
MTN_MOMO_API_SECRET=your-mtn-momo-api-secret
ORANGE_MONEY_API_KEY=your-orange-money-api-key

# ---- Web Scraping & Proxy Rotation ----
# Comma-separated HTTP/SOCKS5 proxies (or leave empty to use built-in pool)
SCRAPER_PROXIES=http://198.51.100.1:8080,http://203.0.113.10:3128
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_MAX_RETRIES=3

# ---- External APIs ----
NUMVERIFY_API_KEY=your-numverify-api-key
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- File Storage ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Email / SMTP Notifications ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@kamstore.cm
